{
  "name": "dsh-usage-dash",
  "version": "0.1.1",
  "description": "DSH web plugin: coding-plan quota dashboard (OpenCode Go / Codex / Volcengine CodingPlan) shown as a sidebar footer badge with an overlay card.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzoro926/dsh-usage-dash.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "usage",
    "quota",
    "opencode",
    "codex",
    "volcengine"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
